+/*
+ * The phone sits in Recovery Mode by default. A bare button combo can't
+ * reliably drop it into DFU (that's a matter of releasing Side at the
+ * exact right instant, which a human eyeballing the screen gets wrong
+ * often). surrealra1n's script instead sends a "reboot" command over USB
+ * while Volume Down is held, so the reboot itself - not your timing - is
+ * the trigger. This replicates that: LED blinks fast while you should be
+ * holding Volume Down + Side, we send the command, then LED blinks slow
+ * for "release Side, keep holding Volume Down".
+ */
+static void trigger_dfu_from_recovery(void) {
+    INFO("Recovery Mode seen: hold Volume Down + Side NOW");
+    led_set_state(LED_STATE_RECOVERY_COUNTDOWN);
+    sleep_ms(RECOVERY_HOLD_BOTH_MS);
+
+    int ret = autoboot_send_recovery_reboot();
+    if (ret != 0) {
+        INFO("reboot command failed (%d), will retry next time Recovery is seen", ret);
+    } else {
+        INFO("reboot command sent");
+    }
+
+    sleep_ms(RECOVERY_HOLD_AFTER_MS);
+
+    INFO("release Side now, KEEP HOLDING Volume Down");
+    led_set_state(LED_STATE_RECOVERY_HOLD);
+    sleep_ms(RECOVERY_HOLD_VOLDOWN_MS);
+
+    usb_bus_reset_open_ep0();
+}
+
+/*
+ * The phone can be plugged in while off or in Recovery; wait here
+ * until it shows up in DFU mode, so a non-DFU device is not an error.
+ */
+static void wait_for_dfu(void) {
+    int shown = -1;
+    bool announced = false;
+
+    while (true) {
+        uint16_t pid = 0;
+
+        if (autoboot_read_pid(&pid) != 0) {
+            // nothing answering, keep breathing
+            if (shown != LED_STATE_IDLE) {
+                led_set_state(LED_STATE_IDLE);
+                shown = LED_STATE_IDLE;
+            }
+
+            sleep_ms(CONNECTION_FAIL_SLEEP_MS);
+            usb_bus_reset_open_ep0();
+            continue;
+        }
+
+        if (pid == APPLE_PID_DFU) {
+            break;
+        }
+
+        if (pid == APPLE_PID_RECOVERY) {
+            trigger_dfu_from_recovery();
+            shown = -1;
+            announced = false;
+            continue;
+        }
+
+        if (!announced) {
+            INFO("device PID:0x%04X is not in DFU, waiting for DFU mode...", pid);
+            announced = true;
+        }
+
+        if (shown != LED_STATE_WAIT_DFU) {
+            led_set_state(LED_STATE_WAIT_DFU);
+            shown = LED_STATE_WAIT_DFU;
+        }
+
+        sleep_ms(NOT_DFU_POLL_MS);
+        usb_bus_reset_open_ep0();
+    }
+
+    INFO("DFU device found, settling...");
+
+    if (shown != LED_STATE_IDLE) {
+        led_set_state(LED_STATE_IDLE);
+    }
+
+    sleep_ms(DFU_SETTLE_MS);
+    usb_bus_reset_open_ep0();
+}
